# Rust 构建产物。
# 本工程的 CARGO_TARGET_DIR 被 scripts/env.sh 指到工作区外，所以这里通常不会有
# target/；保留这条是为了让「不 source env.sh 就直接 cargo build」也不会误提交。
/target/

# wasmtime 的 JIT 缓存。
# scripts/env.sh 把它指到这里，是为了不写 ~/Library/Caches（受限环境下不可写）。
/.wasmtime-cache/

# 端到端测试运行时产生的日志（scripts/e2e-test.sh）
/.e2e-server.log
/.e2e-client.log
/.e2e-hold.log

# 服务端方向的端到端（scripts/e2e-server-test.sh）。
# 其中 .e2e-srv-*.json 是**现场生成的客户端配置，里面有 shortId 与 UUID**
# （每次运行都不一样，但仍然是凭据）—— 一律不入库。
/.e2e-srv-wasm.log
/.e2e-srv-client.log
/.e2e-srv-client.json
/.e2e-srv-bad.log
/.e2e-srv-bad.json

# wasm↔wasm 方向（scripts/e2e-wasm-to-wasm-test.sh）
/.e2e-w2w-srv.log
/.e2e-w2w-cli.log
/.e2e-w2w-cli-env.log
/.e2e-w2w-cli-bad.log

# gen-test-server.sh 生成的一次性测试服务端（含私钥，绝不入库）
/.test-server/

# build-image.sh 拷进构建上下文的 wasm 产物
/xt-wasm-cli.wasm

# 编辑器与系统
.DS_Store
*.swp
